{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-bg: {{ section.settings.background }};
    --marquee-text: {{ section.settings.text }};
    --marquee-size: {{ section.settings.text_size }}px;
    --marquee-padding: {{ section.settings.padding }}px;
  }
{% endstyle %}

{%- liquid
  assign classes = 'marquee'
  if section.settings.direction == 'right'
    assign classes = classes | append: ' marquee--reverse'
  endif
  if section.settings.pause_on_hover
    assign classes = classes | append: ' marquee--pause'
  endif
  if section.settings.uppercase
    assign classes = classes | append: ' marquee--uppercase'
  endif
-%}

{%- if section.blocks.size > 0 -%}
  <div class="{{ classes }}">
    {%- comment -%}
      Two identical groups scroll by their own width, so the second one takes the first one's place without a gap.
      Each group repeats the items to stay wider than the screen.
    {%- endcomment -%}
    {%- for group in (1..2) -%}
      <ul
        class="marquee__group"
        role="list"
        {% if group == 2 %}
          aria-hidden="true"
        {% endif %}
      >
        {%- for repeat in (1..3) -%}
          {%- for block in section.blocks -%}
            <li
              class="marquee__item"
              {% if group == 1 and repeat == 1 %}
                {{ block.shopify_attributes }}
              {% endif %}
            >
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link }}"
                  class="marquee__link"
                  {% if group == 2 or repeat > 1 %}
                    tabindex="-1"
                  {% endif %}
                >
                  {{- block.settings.text -}}
                </a>
              {%- else -%}
                {{- block.settings.text -}}
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per loop",
      "info": "Lower is faster.",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#6C382E"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#FBF3EA"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Made to measure"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Made to measure" } },
        { "type": "text", "settings": { "text": "Cut to your exact width" } },
        { "type": "text", "settings": { "text": "Sewn to order" } },
        { "type": "text", "settings": { "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}
