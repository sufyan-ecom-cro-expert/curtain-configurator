{{ 'curtain-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curtain-configurator.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tiers = product.metafields.custom.pricing_tiers.value
  assign color_option = product.options_by_name[section.settings.color_option]
  assign drop_option = product.options_by_name[section.settings.drop_option]
  assign panel_option = product.options_by_name[section.settings.panel_option]
  assign current_variant = product.selected_or_first_available_variant
  assign heading_font = section.settings.heading_font

  assign width_min = 0
  assign width_max = 0
  for tier in tiers
    if width_min == 0 or tier.min_width.value < width_min
      assign width_min = tier.min_width.value
    endif
    if tier.max_width.value > width_max
      assign width_max = tier.max_width.value
    endif
  endfor

  assign is_ready = false
  if tiers.size > 0 and color_option and drop_option and panel_option
    assign is_ready = true
    assign color_index = color_option.position | minus: 1
    assign drop_index = drop_option.position | minus: 1
    assign panel_index = panel_option.position | minus: 1
    assign selected_color = current_variant.options[color_index]
    assign selected_drop = current_variant.options[drop_index]
    assign selected_width = section.settings.default_width | at_least: width_min | at_most: width_max

    for tier in tiers
      if selected_width >= tier.min_width.value and selected_width <= tier.max_width.value
        assign selected_panels = tier.panels_required.value | append: ''
      endif
    endfor

    assign initial_variant = current_variant
    for variant in product.variants
      if variant.options[color_index] == selected_color and variant.options[drop_index] == selected_drop and variant.options[panel_index] == selected_panels
        assign initial_variant = variant
        break
      endif
    endfor
  endif

  assign active_media = initial_variant.featured_media | default: product.featured_media
  assign swatch_blocks = section.blocks | where: 'type', 'swatch'

  case section.settings.media_ratio
    when 'square'
      assign media_ratio = '1 / 1'
    when 'tall'
      assign media_ratio = '2 / 3'
    else
      assign media_ratio = '4 / 5'
  endcase
-%}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }} {
    --curtain-bg: {{ section.settings.background }};
    --curtain-surface: {{ section.settings.surface }};
    --curtain-text: {{ section.settings.text }};
    --curtain-accent: {{ section.settings.accent }};
    --curtain-hover: {{ section.settings.curtain_color }};
    --curtain-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --curtain-heading-weight: {{ heading_font.weight }};
    --curtain-pad-top: {{ section.settings.padding_top }}px;
    --curtain-pad-bottom: {{ section.settings.padding_bottom }}px;
    --curtain-gap: {{ section.settings.column_gap }}px;
    --curtain-ratio: {{ media_ratio }};
  }
{% endstyle %}

{%- comment -%}
  Measures everything above this section (header, marquee) before the gallery renders,
  so the full-height image never shifts.
{%- endcomment -%}
<script>
  (() => {
    const section = document.currentScript.closest('.shopify-section');
    section.style.setProperty('--curtain-offset-top', `${section.getBoundingClientRect().top + window.scrollY}px`);
  })();
</script>

<div class="curtain-configurator">
  <curtain-configurator class="curtain-configurator__inner page-width">
    <div class="curtain-configurator__gallery{% if product.media.size > 1 %} curtain-configurator__gallery--thumbs{% endif %}">
      <div class="curtain-configurator__stage{% if section.settings.enable_zoom and product.media.size > 0 %} curtain-configurator__stage--zoom{% endif %}">
        {%- for media in product.media -%}
          <div
            class="curtain-configurator__slide{% if media.id == active_media.id %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
            data-zoom-src="{{ media.preview_image | image_url: width: 2400 }}"
          >
            {%- liquid
              assign loading = 'lazy'
              if media.id == active_media.id
                assign loading = 'eager'
              endif
              echo media.preview_image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 992px) 50vw, 100vw', loading: loading, alt: media.alt
            -%}
            {%- if forloop.first and section.settings.image_badge != blank -%}
              <span class="curtain-configurator__image-badge">{{ section.settings.image_badge }}</span>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="curtain-configurator__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'curtain-configurator__placeholder' }}</div>
        {%- endfor -%}

        {%- if section.settings.enable_zoom and product.media.size > 0 -%}
          <div class="curtain-configurator__zoom" aria-hidden="true"></div>
          <button type="button" class="curtain-configurator__zoom-toggle" data-zoom-toggle aria-label="Zoom image" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
              <circle cx="10.5" cy="10.5" r="6.5"/>
              <path d="m15.5 15.5 5 5M7.5 10.5h6"/>
              <path d="M10.5 7.5v6" class="curtain-configurator__zoom-plus"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="curtain-configurator__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="curtain-configurator__thumb"
                data-media-target="{{ media.id }}"
                aria-label="Show image {{ forloop.index }} of {{ forloop.length }}"
                {% if media.id == active_media.id %}
                  aria-current="true"
                {% endif %}
              >
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <form class="curtain-configurator__panel" novalidate>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <p class="curtain-configurator__info curtain-configurator__eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>

          {%- when 'title' -%}
            <h1 class="curtain-configurator__info curtain-configurator__title" {{ block.shopify_attributes }}>
              {{- block.settings.heading | default: product.title -}}
            </h1>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="curtain-configurator__info curtain-configurator__intro rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'width' -%}
            {%- if is_ready -%}
              <div class="curtain-configurator__step" {{ block.shopify_attributes }}>
                <label class="curtain-configurator__label" for="CurtainWidth-{{ section.id }}">
                  <span class="curtain-configurator__index" aria-hidden="true"></span>
                  {{ block.settings.label }}
                </label>
                <div class="curtain-configurator__width">
                  <input
                    id="CurtainWidth-{{ section.id }}"
                    class="curtain-configurator__width-input"
                    type="number"
                    name="width"
                    inputmode="numeric"
                    step="1"
                    min="{{ width_min }}"
                    max="{{ width_max }}"
                    value="{{ selected_width }}"
                    required
                    aria-describedby="CurtainWidthHint-{{ section.id }} CurtainWidthError-{{ section.id }}"
                  >
                  <span class="curtain-configurator__unit" aria-hidden="true">cm</span>
                </div>
                <div class="curtain-configurator__message">
                  <p id="CurtainWidthHint-{{ section.id }}" class="curtain-configurator__hint">
                    {{ block.settings.hint }}
                    {{ width_min }}–{{ width_max }} cm, whole numbers.
                  </p>
                  <p
                    id="CurtainWidthError-{{ section.id }}"
                    class="curtain-configurator__error"
                    data-width-error
                    hidden
                  ></p>
                </div>
              </div>
            {%- endif -%}

          {%- when 'drop' -%}
            {%- if is_ready -%}
              <fieldset class="curtain-configurator__step" {{ block.shopify_attributes }}>
                <legend class="curtain-configurator__label">
                  <span class="curtain-configurator__index" aria-hidden="true"></span>
                  {{ block.settings.label }}
                </legend>
                <div class="curtain-configurator__drops">
                  {%- for value in drop_option.values -%}
                    <input
                      type="radio"
                      class="curtain-configurator__radio"
                      id="CurtainDrop-{{ section.id }}-{{ forloop.index }}"
                      name="drop"
                      value="{{ value.name | escape }}"
                      data-step="{{ forloop.index0 }}"
                      {% if value.name == selected_drop %}
                        checked
                      {% endif %}
                    >
                    <label class="curtain-configurator__drop" for="CurtainDrop-{{ section.id }}-{{ forloop.index }}">
                      {{- value.name -}}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}

          {%- when 'fabric' -%}
            {%- if is_ready -%}
              <fieldset class="curtain-configurator__step" {{ block.shopify_attributes }}>
                <legend class="curtain-configurator__label">
                  <span class="curtain-configurator__index" aria-hidden="true"></span>
                  {{ block.settings.label }}
                  <span class="curtain-configurator__selected" data-selected-color>{{ selected_color }}</span>
                </legend>
                <div class="curtain-configurator__swatches">
                  {%- for swatch in swatch_blocks -%}
                    {%- render 'curtain-swatch',
                      section_id: section.id,
                      index: forloop.index,
                      value: swatch.settings.option_value,
                      color: swatch.settings.color,
                      image: swatch.settings.image,
                      selected_color: selected_color,
                      attributes: swatch.shopify_attributes
                    -%}
                  {%- else -%}
                    {%- for value in color_option.values -%}
                      {%- render 'curtain-swatch',
                        section_id: section.id,
                        index: forloop.index,
                        value: value.name,
                        color: value.swatch.color,
                        image: value.swatch.image,
                        selected_color: selected_color
                      -%}
                    {%- endfor -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}

          {%- when 'buy' -%}
            {%- if is_ready -%}
              {%- liquid
                assign note = block.settings.note
                assign has_dates = false
                if note contains '[start]' or note contains '[end]'
                  assign has_dates = true
                endif
              -%}
              <div class="curtain-configurator__summary" {{ block.shopify_attributes }}>
                <div class="curtain-configurator__summary-head">
                  <span class="curtain-configurator__summary-title">{{ block.settings.title }}</span>
                  <output class="curtain-configurator__price" data-price aria-live="polite" aria-atomic="true">
                    {{- initial_variant.price | money -}}
                  </output>
                </div>

                <dl class="curtain-configurator__specs">
                  <div>
                    <dt>Width</dt>
                    <dd data-spec="width">{{ selected_width }} cm</dd>
                  </div>
                  <div>
                    <dt>Drop</dt>
                    <dd data-spec="drop">{{ selected_drop }}</dd>
                  </div>
                  <div>
                    <dt>Fabric</dt>
                    <dd data-spec="color">{{ selected_color }}</dd>
                  </div>
                  {%- if block.settings.show_panel_info -%}
                    <div>
                      <dt>Fabric panels</dt>
                      <dd data-spec="panels">{{ selected_panels }}</dd>
                    </div>
                  {%- endif -%}
                </dl>

                <button type="submit" class="curtain-configurator__submit" data-submit>
                  <span class="curtain-configurator__submit-label" data-submit-label>
                    {{- 'products.product.add_to_cart' | t }} – {{ initial_variant.price | money -}}
                  </span>
                  <span class="curtain-configurator__spinner" aria-hidden="true"></span>
                </button>

                <div class="curtain-configurator__summary-foot">
                  <p class="curtain-configurator__form-error" data-form-error role="alert"></p>
                  {%- if note != blank -%}
                    <p
                      class="curtain-configurator__note"
                      {% if has_dates %}
                        data-delivery-note="{{ note | escape }}"
                        data-min-days="{{ block.settings.delivery_min_days }}"
                        data-max-days="{{ block.settings.delivery_max_days }}"
                        data-working-days="{{ block.settings.delivery_working_days }}"
                      {% endif %}
                    >
                      {%- unless has_dates %}{{ note }}{% endunless -%}
                    </p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'marquee' -%}
            {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
            <div class="curtain-configurator__marquee" style="--curtain-marquee-speed: {{ block.settings.speed }}s" {{ block.shopify_attributes }}>
              {%- comment -%} The second group is a copy that slides in behind the first for a seamless loop. {%- endcomment -%}
              {%- for group in (1..2) -%}
                <ul
                  class="curtain-configurator__marquee-group"
                  role="list"
                  {% if group == 2 %}
                    aria-hidden="true"
                  {% endif %}
                >
                  {%- for item in items -%}
                    {%- assign text = item | strip -%}
                    {%- if text != blank -%}
                      <li class="curtain-configurator__marquee-item">{{ text }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endfor -%}
            </div>

          {%- when 'trust_badges' -%}
            <ul class="curtain-configurator__badges" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- liquid
                  assign title_key = 'title_' | append: i
                  assign text_key = 'text_' | append: i
                  assign icon_key = 'icon_' | append: i
                -%}
                {%- if block.settings[title_key] != blank -%}
                  <li class="curtain-configurator__badge">
                    {%- render 'curtain-trust-icon', icon: block.settings[icon_key] -%}
                    <span class="curtain-configurator__badge-title">{{ block.settings[title_key] }}</span>
                    {%- if block.settings[text_key] != blank -%}
                      <span class="curtain-configurator__badge-text">{{ block.settings[text_key] }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'collapsible_row' -%}
            <details
              class="curtain-configurator__row{% if block.settings.open %} is-open{% endif %}"
              {% if block.settings.open %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="curtain-configurator__row-title">
                {{- block.settings.heading -}}
                <span class="curtain-configurator__row-icon" aria-hidden="true"></span>
              </summary>
              <div class="curtain-configurator__row-content rte">{{ block.settings.content }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}

      {%- if is_ready == false and request.design_mode -%}
        <p class="curtain-configurator__notice">
          Link Curtain Pricing Tier entries to this product's <code>custom.pricing_tiers</code> metafield and make sure
          the product has {{ section.settings.color_option }}, {{ section.settings.drop_option }} and
          {{ section.settings.panel_option }} options.
        </p>
      {%- endif -%}
    </form>

    {%- if is_ready -%}
    <script type="application/json" data-config>
      {
        "tiers": [
          {%- for tier in tiers -%}
            {
              "minWidth": {{ tier.min_width.value | json }},
              "maxWidth": {{ tier.max_width.value | json }},
              "panels": {{ tier.panels_required.value | json }},
              "basePrice": {{ tier.base_price.value | json }},
              "pricePerDropTier": {{ tier.price_per_drop_tier.value | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "optionIndex": { "color": {{ color_index }}, "drop": {{ drop_index }}, "panels": {{ panel_index }} },
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "price": {{ variant.price }},
              "available": {{ variant.available }},
              "options": {{ variant.options | json }},
              "mediaId": {{ variant.featured_media.id | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "moneyFormat": {{ shop.money_format | json }},
        "strings": {
          "addToCart": {{ 'products.product.add_to_cart' | t | json }},
          "soldOut": {{ 'products.product.sold_out' | t | json }},
          "unavailable": {{ 'products.product.unavailable' | t | json }},
          "enterWidth": "Enter a valid width",
          "adding": "Adding…",
          "added": "Added to cart",
          "widthEmpty": "Enter your width in centimetres.",
          "widthInteger": "Use whole centimetres, for example 180.",
          "widthRange": "Width must be between {{ width_min }} and {{ width_max }} cm.",
          "widthUnpriced": "This width can't be priced yet. Please contact us.",
          "cartError": "Something went wrong. Please try again."
        }
      }
    </script>
    {%- endif -%}
  </curtain-configurator>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Curtain configurator",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image ratio",
      "info": "Used on tablet and mobile. On desktop the main image fills the screen height.",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "tall",
          "label": "Tall"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "image_badge",
      "label": "Image badge",
      "info": "Shown on the first image. Leave blank to hide.",
      "default": "Custom Fit"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom",
      "info": "Hover to zoom on desktop. Tap to zoom on touch screens.",
      "default": true
    },
    {
      "type": "header",
      "content": "Configuration"
    },
    {
      "type": "number",
      "id": "default_width",
      "label": "Default width (cm)",
      "default": 150
    },
    {
      "type": "text",
      "id": "color_option",
      "label": "Color option name",
      "default": "Color"
    },
    {
      "type": "text",
      "id": "drop_option",
      "label": "Drop option name",
      "default": "Drop"
    },
    {
      "type": "text",
      "id": "panel_option",
      "label": "Panels option name",
      "default": "Panels",
      "info": "This option is never shown. Its variant is picked from the width."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "cormorant_n5"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "surface",
      "label": "Alternative background",
      "info": "Used for the summary card, inputs and image backdrop.",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#1E1C19"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#2E4A42"
    },
    {
      "type": "color",
      "id": "curtain_color",
      "label": "Button hover curtain",
      "info": "The fabric that drops over the add to cart button on hover.",
      "default": "#F3E4D4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to use the product title."
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "width",
      "name": "Width input",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Width"
        },
        {
          "type": "text",
          "id": "hint",
          "label": "Hint",
          "default": "Measure your track or pole.",
          "info": "The allowed range is added after the hint."
        }
      ]
    },
    {
      "type": "drop",
      "name": "Drop picker",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Drop"
        }
      ]
    },
    {
      "type": "fabric",
      "name": "Fabric picker",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Fabric"
        },
        {
          "type": "paragraph",
          "content": "Add a Fabric swatch block for each color. Without swatch blocks, the product's color values are shown."
        }
      ]
    },
    {
      "type": "swatch",
      "name": "Fabric swatch",
      "settings": [
        {
          "type": "text",
          "id": "option_value",
          "label": "Color option value",
          "info": "Must match the variant's color value exactly, e.g. Ivory."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Swatch color",
          "default": "#E8E1D4"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fabric image",
          "info": "Optional. Replaces the swatch color."
        }
      ]
    },
    {
      "type": "buy",
      "name": "Price and add to cart",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Your curtain"
        },
        {
          "type": "checkbox",
          "id": "show_panel_info",
          "label": "Show fabric panel count",
          "default": true
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note under button",
          "default": "Made to order · Ships [start] to [end]",
          "info": "Use [start] and [end] to show dates that update every day."
        },
        {
          "type": "range",
          "id": "delivery_min_days",
          "label": "Earliest date (days from today)",
          "min": 0,
          "max": 30,
          "step": 1,
          "default": 7
