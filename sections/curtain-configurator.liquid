{{ 'curtain-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curtain-configurator.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tiers = product.metafields.custom.pricing_tiers.value
  assign color_option = product.options_by_name[section.settings.color_option]
  assign drop_option = product.options_by_name[section.settings.drop_option]
  assign panel_option = product.options_by_name[section.settings.panel_option]
  assign current_variant = product.selected_or_first_available_variant
  assign heading_font = section.settings.heading_font

  assign width_min = 0
  assign width_max = 0
  for tier in tiers
    if width_min == 0 or tier.min_width.value < width_min
      assign width_min = tier.min_width.value
    endif
    if tier.max_width.value > width_max
      assign width_max = tier.max_width.value
    endif
  endfor

  assign is_ready = false
  if tiers.size > 0 and color_option and drop_option and panel_option
    assign is_ready = true
    assign color_index = color_option.position | minus: 1
    assign drop_index = drop_option.position | minus: 1
    assign panel_index = panel_option.position | minus: 1
    assign selected_color = current_variant.options[color_index]
    assign selected_drop = current_variant.options[drop_index]
    assign selected_width = section.settings.default_width | at_least: width_min | at_most: width_max

    for tier in tiers
      if selected_width >= tier.min_width.value and selected_width <= tier.max_width.value
        assign selected_panels = tier.panels_required.value | append: ''
      endif
    endfor

    assign initial_variant = current_variant
    for variant in product.variants
      if variant.options[color_index] == selected_color and variant.options[drop_index] == selected_drop and variant.options[panel_index] == selected_panels
        assign initial_variant = variant
        break
      endif
    endfor
  endif

  assign active_media = initial_variant.featured_media | default: product.featured_media
  case section.settings.media_ratio
    when 'square'
      assign media_ratio = '1 / 1'
    when 'tall'
      assign media_ratio = '2 / 3'
    else
      assign media_ratio = '4 / 5'
  endcase
-%}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }} {
    --cc-bg: {{ section.settings.background }};
    --cc-surface: {{ section.settings.surface }};
    --cc-text: {{ section.settings.text }};
    --cc-accent: {{ section.settings.accent }};
    --cc-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --cc-heading-weight: {{ heading_font.weight }};
    --cc-pad-top: {{ section.settings.padding_top }}px;
    --cc-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cc-gap: {{ section.settings.column_gap }}px;
    --cc-ratio: {{ media_ratio }};
  }
{% endstyle %}

<div class="cc">
  <curtain-configurator class="cc__inner page-width">
    <div class="cc__gallery">
      <div class="cc__stage">
        {%- for media in product.media -%}
          <div
            class="cc__slide{% if media.id == active_media.id %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
          >
            {%- liquid
              assign loading = 'lazy'
              if media.id == active_media.id
                assign loading = 'eager'
              endif
              echo media.preview_image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 992px) 55vw, 100vw', loading: loading, alt: media.alt
            -%}
          </div>
        {%- else -%}
          <div class="cc__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'cc__placeholder' }}</div>
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="cc__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="cc__thumb"
                data-media-target="{{ media.id }}"
                aria-label="Show image {{ forloop.index }} of {{ forloop.length }}"
                {% if media.id == active_media.id %}
                  aria-current="true"
                {% endif %}
              >
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="cc__panel">
      <div class="cc__head">
        {%- if section.settings.show_vendor -%}
          <p class="cc__eyebrow">{{ product.vendor }}</p>
        {%- endif -%}
        <h1 class="cc__title">{{ section.settings.heading | default: product.title }}</h1>
        {%- if section.settings.show_description and product.description != blank -%}
          <div class="cc__intro rte">{{ product.description }}</div>
        {%- endif -%}
      </div>

      {%- if is_ready -%}
        <form class="cc__form" novalidate>
          <div class="cc__step">
            <label class="cc__label" for="CurtainWidth-{{ section.id }}">
              <span class="cc__index">01</span> Width
            </label>
            <div class="cc__width">
              <input
                id="CurtainWidth-{{ section.id }}"
                class="cc__width-input"
                type="number"
                name="width"
                inputmode="numeric"
                step="1"
                min="{{ width_min }}"
                max="{{ width_max }}"
                value="{{ selected_width }}"
                required
                aria-describedby="CurtainWidthHint-{{ section.id }} CurtainWidthError-{{ section.id }}"
              >
              <span class="cc__unit" aria-hidden="true">cm</span>
            </div>
            <div class="cc__message">
              <p id="CurtainWidthHint-{{ section.id }}" class="cc__hint">
                Measure your track or pole. {{ width_min }}–{{ width_max }} cm, whole numbers.
              </p>
              <p
                id="CurtainWidthError-{{ section.id }}"
                class="cc__error"
                data-width-error
                hidden
              ></p>
            </div>
          </div>

          <fieldset class="cc__step">
            <legend class="cc__label"><span class="cc__index">02</span> Drop</legend>
            <div class="cc__drops">
              {%- for value in drop_option.values -%}
                <input
                  type="radio"
                  class="cc__radio"
                  id="CurtainDrop-{{ section.id }}-{{ forloop.index }}"
                  name="drop"
                  value="{{ value.name | escape }}"
                  data-step="{{ forloop.index0 }}"
                  {% if value.name == selected_drop %}
                    checked
                  {% endif %}
                >
                <label class="cc__drop" for="CurtainDrop-{{ section.id }}-{{ forloop.index }}">
                  {{- value.name -}}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>

          <fieldset class="cc__step">
            <legend class="cc__label">
              <span class="cc__index">03</span> Fabric
              <span class="cc__selected" data-selected-color>{{ selected_color }}</span>
            </legend>
            <div class="cc__swatches">
              {%- for block in section.blocks -%}
                {%- render 'curtain-swatch',
                  section_id: section.id,
                  index: forloop.index,
                  value: block.settings.option_value,
                  color: block.settings.color,
                  image: block.settings.image,
                  selected_color: selected_color,
                  attributes: block.shopify_attributes
                -%}
              {%- else -%}
                {%- for value in color_option.values -%}
                  {%- render 'curtain-swatch',
                    section_id: section.id,
                    index: forloop.index,
                    value: value.name,
                    color: value.swatch.color,
                    image: value.swatch.image,
                    selected_color: selected_color
                  -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </fieldset>

          <div class="cc__summary">
            <div class="cc__summary-head">
              <span class="cc__summary-title">Your curtain</span>
              <output class="cc__price" data-price aria-live="polite" aria-atomic="true">
                {{- initial_variant.price | money -}}
              </output>
            </div>

            <dl class="cc__specs">
              <div>
                <dt>Width</dt>
                <dd data-spec="width">{{ selected_width }} cm</dd>
              </div>
              <div>
                <dt>Drop</dt>
                <dd data-spec="drop">{{ selected_drop }}</dd>
              </div>
              <div>
                <dt>Fabric</dt>
                <dd data-spec="color">{{ selected_color }}</dd>
              </div>
              {%- if section.settings.show_panel_info -%}
                <div>
                  <dt>Fabric panels</dt>
                  <dd data-spec="panels">{{ selected_panels }}</dd>
                </div>
              {%- endif -%}
            </dl>

            <button type="submit" class="cc__submit" data-submit>
              <span class="cc__submit-label" data-submit-label>
                {{- 'products.product.add_to_cart' | t }} – {{ initial_variant.price | money -}}
              </span>
              <span class="cc__spinner" aria-hidden="true"></span>
            </button>

            <p class="cc__form-error" data-form-error role="alert"></p>

            {%- if section.settings.note != blank -%}
              <p class="cc__note">{{ section.settings.note }}</p>
            {%- endif -%}
          </div>
        </form>

        <script type="application/json" data-config>
          {
            "tiers": [
              {%- for tier in tiers -%}
                {
                  "minWidth": {{ tier.min_width.value | json }},
                  "maxWidth": {{ tier.max_width.value | json }},
                  "panels": {{ tier.panels_required.value | json }},
                  "basePrice": {{ tier.base_price.value | json }},
                  "pricePerDropTier": {{ tier.price_per_drop_tier.value | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ],
            "optionIndex": { "color": {{ color_index }}, "drop": {{ drop_index }}, "panels": {{ panel_index }} },
            "variants": [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "price": {{ variant.price }},
                  "available": {{ variant.available }},
                  "options": {{ variant.options | json }},
                  "mediaId": {{ variant.featured_media.id | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ],
            "moneyFormat": {{ shop.money_format | json }},
            "strings": {
              "addToCart": {{ 'products.product.add_to_cart' | t | json }},
              "soldOut": {{ 'products.product.sold_out' | t | json }},
              "unavailable": {{ 'products.product.unavailable' | t | json }},
              "enterWidth": "Enter a valid width",
              "adding": "Adding…",
              "added": "Added to cart",
              "widthEmpty": "Enter your width in centimetres.",
              "widthInteger": "Use whole centimetres, for example 180.",
              "widthRange": "Width must be between {{ width_min }} and {{ width_max }} cm.",
              "widthUnpriced": "This width can't be priced yet. Please contact us.",
              "cartError": "Something went wrong. Please try again."
            }
          }
        </script>
      {%- elsif request.design_mode -%}
        <p class="cc__notice">
          Link Curtain Pricing Tier entries to this product's <code>custom.pricing_tiers</code> metafield and make sure
          the product has {{ section.settings.color_option }}, {{ section.settings.drop_option }} and
          {{ section.settings.panel_option }} options.
        </p>
      {%- endif -%}
    </div>
  </curtain-configurator>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Curtain configurator",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_panel_info",
      "label": "Show fabric panel count",
      "default": true
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under button",
      "default": "Made to order in 7–10 working days"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "tall", "label": "Tall" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Configuration"
    },
    {
      "type": "number",
      "id": "default_width",
      "label": "Default width (cm)",
      "default": 150
    },
    {
      "type": "text",
      "id": "color_option",
      "label": "Color option name",
      "default": "Color"
    },
    {
      "type": "text",
      "id": "drop_option",
      "label": "Drop option name",
      "default": "Drop"
    },
    {
      "type": "text",
      "id": "panel_option",
      "label": "Panels option name",
      "default": "Panels",
      "info": "This option is never shown. Its variant is picked from the width."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "cormorant_n5"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F5F1EA"
    },
    {
      "type": "color",
      "id": "surface",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#1E1C19"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#2E4A42"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "swatch",
      "name": "Fabric swatch",
      "settings": [
        {
          "type": "text",
          "id": "option_value",
          "label": "Color option value",
          "info": "Must match the variant's color value exactly, e.g. Ivory."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Swatch color",
          "default": "#E8E1D4"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fabric image",
          "info": "Optional. Replaces the swatch color."
        }
      ]
    }
  ]
}
{% endschema %}
