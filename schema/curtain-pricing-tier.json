      "Color": [
        "Ivory",
        "Stone Grey",
        "Teal"
      ],
      "Drop": [
        "150cm",
        "200cm",
        "250cm"
      ],
      "Panels": [
        "1",
        "2",
        "3"
      ]
    },
    "variantPrice": "base_price + price_per_drop_tier * dropStep, where dropStep is the Drop value's position (150cm = 0, 200cm = 1, 250cm = 2)"
