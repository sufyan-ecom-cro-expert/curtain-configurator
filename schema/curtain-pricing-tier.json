{
  "metaobjectDefinition": {
    "name": "Curtain Pricing Tier",
    "type": "curtain_pricing_tier",
    "description": "Width ranges that decide fabric panel count and price for made-to-measure curtains.",
    "access": {
      "storefront": "PUBLIC_READ"
    },
    "fieldDefinitions": [
      {
        "key": "min_width",
        "name": "Min width (cm)",
        "type": "number_integer",
        "required": true,
        "validations": [
          {
            "name": "min",
            "value": "1"
          }
        ]
      },
      {
        "key": "max_width",
        "name": "Max width (cm)",
        "type": "number_integer",
        "required": true,
        "validations": [
          {
            "name": "min",
            "value": "1"
          }
        ]
      },
      {
        "key": "panels_required",
        "name": "Panels required",
        "type": "number_integer",
        "required": true,
        "validations": [
          {
            "name": "min",
            "value": "1"
          }
        ]
      },
      {
        "key": "base_price",
        "name": "Base price",
        "type": "number_decimal",
        "required": true,
        "validations": [
          {
            "name": "min",
            "value": "0"
          }
        ]
      },
      {
        "key": "price_per_drop_tier",
        "name": "Price per drop tier",
        "type": "number_decimal",
        "required": true,
        "validations": [
          {
            "name": "min",
            "value": "0"
          }
        ]
      }
    ]
  },
  "entries": [
    {
      "handle": "tier-1-panel",
      "fields": {
        "min_width": 50,
