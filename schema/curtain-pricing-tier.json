      }
    },
    {
      "handle": "tier-2-panels",
      "fields": {
        "min_width": 121,
        "max_width": 240,
        "panels_required": 2,
        "base_price": "22000.00",
        "price_per_drop_tier": "4500.00"
      }
    },
    {
      "handle": "tier-3-panels",
      "fields": {
        "min_width": 241,
        "max_width": 360,
        "panels_required": 3,
        "base_price": "32000.00",
        "price_per_drop_tier": "6500.00"
      }
    }
